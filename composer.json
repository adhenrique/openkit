{
  "name": "adhenrique/openkit",
  "description": "Uma biblioteca elegante com interface fluente para gerar documentação OpenAPI (Swagger) em aplicações Laravel.",
  "keywords": [
    "laravel",
    "openapi",
    "swagger",
    "docs",
    "api",
    "documentation",
    "fluent"
  ],
  "type": "laravel-package",
  "license": "MIT",
  "authors": [
    {
      "name": "AD henrique",
      "email": "eu@adhenrique.com.br"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0 | ^11.0 | ^12.0",
    "illuminate/routing": "^10.0 | ^11.0 | ^12.0",
    "illuminate/console": "^10.0 | ^11.0 | ^12.0",
    "illuminate/view": "^10.0 | ^11.0 | ^12.0",
    "illuminate/filesystem": "^10.0 | ^11.0 | ^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "OpenKit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
    "post-install-cmd": [
      "whisky update"
    ],
    "post-update-cmd": [
      "whisky update"
    ],
    "tests": [
      "./vendor/bin/phpunit",
      "./vendor/bin/pint --test",
      "./vendor/bin/phpstan analyse",
      "@php composer audit"
    ],
    "lint-staged": [
      "git diff --name-only --cached --diff-filter=ACM | grep -E '\\.php$' | xargs -r ./vendor/bin/pint --test",
      "git diff --name-only --cached --diff-filter=ACM | grep -E '\\.php$' | xargs -r ./vendor/bin/phpstan analyse"
    ]
  },
  "script-descriptions": {
    "tests": "Runs code quality checks: Pint formatting test, PHPStan static analysis, and Composer audit for dependency vulnerabilities.",
    "lint-staged": "Runs Pint and PHPStan only on staged files (typically used in pre-commit hooks)."
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "OpenKit\\OpenKitServiceProvider"
      ],
      "aliases": {
        "OpenKit": "OpenKit\\Facades\\OpenKit"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}